  "faq": {
    "title": "FAQ",
    "blocks": [
      {
        "id": "faq_001",
        "type": "section-header",
        "data": {
          "eyebrow": "Got questions?",
          "heading": "Frequently Asked Questions",
          "subheading": "Everything you need to know before your visit.",
          "alignment": "center"
        }
      },
      {
        "id": "faq_002",
        "type": "faq-accordion",
        "data": {
          "items": [
            {
              "question": "Do I need an appointment?",
              "answer": "No appointment is needed for blood draws at any of our four locations. Simply walk in during open hours and our team will take care of you."
            },
            {
              "question": "Do I need to fast before my blood draw?",
              "answer": "It depends on the test. Common panels like lipids and glucose require 8–12 hours of fasting. Your provider's order will specify if fasting is required. When in doubt, call ahead and we'll check for you."
            },
            {
              "question": "Can I drink water before my test?",
              "answer": "Yes — plain water is always allowed and actually encouraged. Staying hydrated makes veins easier to access and your draw more comfortable."
            },
            {
              "question": "How long does it take?",
              "answer": "Most patients are in and out in under 20 minutes. The draw itself typically takes 5 minutes or less."
            },
            {
              "question": "How much does it cost without insurance?",
              "answer": "We publish flat self-pay rates for the most common panels. A basic metabolic panel is $32, a lipid panel is $36, and a CBC is $24. Ask the front desk for a full price list."
            },
            {
              "question": "How long do results take?",
              "answer": "Routine panels are typically available same day or within 24 hours. Specialty tests and cultures may take 2–7 days depending on the test."
            },
            {
              "question": "Do you accept HSA and FSA cards?",
              "answer": "Yes, we accept HSA and FSA cards at all locations."
            }
          ]
        }
      },
      {
        "id": "faq_003",
        "type": "cta-band",
        "data": {
          "heading": "Still have questions?",
          "body": "Our team is happy to help. Call any location directly or send us a message.",
          "background": "navy",
          "cta1Text": "Contact us",
          "cta1Href": "Contact.html",
          "cta2Text": "Find a location",
          "cta2Href": "Locations.html"
        }
      }
    ]
  },
